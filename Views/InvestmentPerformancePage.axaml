<UserControl
    x:Class="Reckoner.Views.InvestmentPerformancePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Reckoner.Behaviors"
    xmlns:controls="clr-namespace:Reckoner.Controls"
    xmlns:local="clr-namespace:Reckoner.Converters"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
    xmlns:model="clr-namespace:Reckoner.Models"
    xmlns:views="clr-namespace:Reckoner.Views"
    xmlns:vm="clr-namespace:Reckoner.ViewModels"
    x:DataType="vm:InvestmentPerformanceViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <local:PlayPauseTextConverter x:Key="PlayPauseTextConverter" />
            <local:DateTimeOffsetToDateTimeConverter x:Key="DateOnlyConverter" />
            <local:BooleanToHeightConverter x:Key="BooleanToHeightConverter" />
            <local:NullToTextConverter
                x:Key="NullChecker"
                NotNullText="✅ OK"
                NullText="❌ NULL" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto, *, Auto">
        <StackPanel Grid.Row="0" Margin="20">

            <!--  Stocks row  -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding SimSettingsVM.ActiveSimSettings.Holdings}">
                        <ItemsControl.Styles>
                            <!--  Hide the pipe on the very first item  -->
                            <Style Selector="ContentPresenter:nth-child(1) TextBlock.pipe-separator">
                                <Setter Property="IsVisible" Value="False" />
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="model:SecurityHolding">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <TextBlock
                                        Classes="pipe-separator"
                                        VerticalAlignment="Center"
                                        Foreground="#AAAAAA"
                                        FontSize="16"
                                        Text="|"
                                        Margin="0,0,16,2" />
                                    <StackPanel Orientation="Vertical" Spacing="2">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="{Binding TickerSymbol}" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <controls:DecimalInput
                                                ErrorMessage="Use format 100.00"
                                                FormatString="0.00"
                                                Watermark="25.00"
                                                Value="{Binding ContributionPercentageX100}" />
                                            <TextBlock VerticalAlignment="Center" Text="%" />
                                        </StackPanel>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            Content="Track in Export"
                                            FontSize="11"
                                            IsChecked="{Binding TrackInExport}"
                                            ToolTip.Tip="Include this ticker's raw Close price and running All-Time High as columns in the Excel export." />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  + button, hidden while search is open  -->
                    <Border
                        Margin="5"
                        Padding="10"
                        IsVisible="{Binding !ShowSearchView}"
                        Background="White"
                        BorderThickness="1"
                        BoxShadow="0 2 5 #00000033"
                        CornerRadius="8">
                        <Button
                            Width="120"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Classes="primary"
                            Command="{Binding AddNewHoldingCommand}"
                            Content="+"
                            FontSize="24" />
                    </Border>

                    <!--  Search panel with cancel, shown when search is open  -->
                    <Border
                        Margin="5"
                        Padding="10"
                        IsVisible="{Binding ShowSearchView}"
                        Background="White"
                        BorderThickness="1"
                        BoxShadow="0 2 5 #00000033"
                        CornerRadius="8">
                        <StackPanel Spacing="6">
                            <views:StockSearchUC
                                x:Name="StockSearchUC"
                                DataContext="{Binding StockSearchVM}" />
                            <Button
                                HorizontalAlignment="Center"
                                Classes="primary"
                                Command="{Binding CancelAddHoldingCommand}"
                                Content="✕ Cancel" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Margin="0,8,0,4" HorizontalAlignment="Center" Spacing="6">

                <!--  Row 1: Strategy · Ref Ticker · DRIP  -->
                <WrapPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                        <Label VerticalAlignment="Center" FontSize="13" Content="Strategy:" />
                        <ComboBox
                            VerticalAlignment="Center"
                            ItemsSource="{Binding SimSettingsVM.InvestmentStrategies}"
                            SelectedItem="{Binding SimSettingsVM.ActiveSimSettings.Strategy}" />
                        <Button
                            Background="Transparent"
                            Command="{Binding SimSettingsVM.OpenStrategySettingsCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="⚙️"
                            FontSize="20"
                            IsVisible="{Binding SimSettingsVM.UseFWStrategy}" />
                    </StackPanel>
                    <StackPanel
                        IsVisible="{Binding SimSettingsVM.UseFWStrategy}"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="0,2">
                        <TextBlock VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="16" Text="|" Margin="10,0,0,0" />
                        <Label VerticalAlignment="Center" FontSize="13" Content="Ref Ticker:" />
                        <ComboBox
                            VerticalAlignment="Center"
                            ItemsSource="{Binding SimSettingsVM.ActiveSimSettings.Holdings}"
                            SelectedItem="{Binding SimSettingsVM.SelectedFwTicker}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TickerSymbol}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                        <TextBlock VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="16" Text="|" Margin="10,0,0,0" />
                        <Label VerticalAlignment="Center" FontSize="13" Content="DRIP:" />
                        <CheckBox VerticalAlignment="Center" IsChecked="{Binding SimSettingsVM.ActiveSimSettings.DividendReinvestment}" />
                    </StackPanel>
                </WrapPanel>

                <!--  Row 2: Initial Investment · Contribution Amount · Frequency · Day/Date · Rebalance  -->
                <WrapPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                        <Label VerticalAlignment="Center" FontSize="13" Content="Initial Investment:" />
                        <controls:DecimalInput
                            ErrorMessage="Use format 1000.00"
                            FormatString="0.00"
                            Watermark="1000.00"
                            Value="{Binding SimSettingsVM.ActiveSimSettings.InitialCash}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                        <TextBlock VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="16" Text="|" Margin="10,0,0,0" />
                        <Label VerticalAlignment="Center" FontSize="13" Content="Contribution Amount:" />
                        <controls:DecimalInput
                            ErrorMessage="Use format 1000.00"
                            FormatString="0.00"
                            Watermark="100.0"
                            Value="{Binding SimSettingsVM.ActiveSimSettings.ContributionAmount}" />
                        <ComboBox
                            VerticalAlignment="Center"
                            Foreground="Blue"
                            ItemsSource="{Binding SimSettingsVM.BreadownOptions}"
                            SelectedItem="{Binding SimSettingsVM.ActiveSimSettings.ContributionHelper}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                        <TextBlock VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="16" Text="|" Margin="10,0,0,0" />
                        <Label VerticalAlignment="Center" FontSize="13" Content="Contribution Frequency:" />
                        <ComboBox
                            VerticalAlignment="Center"
                            Foreground="Blue"
                            ItemsSource="{Binding SimSettingsVM.ContributionFrequencies}"
                            SelectedItem="{Binding SimSettingsVM.ActiveSimSettings.ContributionInterval}" />
                    </StackPanel>
                    <StackPanel
                        IsVisible="{Binding SimSettingsVM.ShowDayPicker}"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="0,2">
                        <TextBlock VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="16" Text="|" Margin="10,0,0,0" />
                        <Label VerticalAlignment="Center" FontSize="13" Content="Day of the Week:" />
                        <ComboBox
                            VerticalAlignment="Center"
                            ItemsSource="{Binding SimSettingsVM.DaysOfWeek}"
                            SelectedItem="{Binding SimSettingsVM.ActiveSimSettings.SelectedDayOfWeek}" />
                    </StackPanel>
                    <StackPanel
                        IsVisible="{Binding SimSettingsVM.ShowDateEntry}"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="0,2">
                        <TextBlock VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="16" Text="|" Margin="10,0,0,0" />
                        <Label VerticalAlignment="Center" FontSize="13" Content="Days:" />
                        <TextBox
                            VerticalAlignment="Center"
                            Text="{Binding SimSettingsVM.ActiveSimSettings.ContributionDates}"
                            Watermark="1, 15"
                            ToolTip.Tip="{Binding SimSettingsVM.DateHelperText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                        <TextBlock VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="16" Text="|" Margin="10,0,0,0" />
                        <Label VerticalAlignment="Center" FontSize="13" Content="Rebalance Frequency:" />
                        <ComboBox
                            VerticalAlignment="Center"
                            Foreground="Blue"
                            ItemsSource="{Binding SimSettingsVM.ContributionFrequencies}"
                            SelectedItem="{Binding SimSettingsVM.ActiveSimSettings.RebalanceInterval}" />
                    </StackPanel>
                </WrapPanel>

                <!--  Row 4: Start Date · End Date  -->
                <WrapPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                        <Label VerticalAlignment="Center" FontSize="13" Content="Start Date:" />
                        <DatePicker SelectedDate="{Binding SimSettingsVM.ActiveSimSettings.StartDateOffset, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                        <TextBlock VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="16" Text="|" Margin="10,0,0,0" />
                        <Label VerticalAlignment="Center" FontSize="13" Content="End Date:" />
                        <DatePicker SelectedDate="{Binding SimSettingsVM.ActiveSimSettings.EndDateOffset, Mode=TwoWay}" />
                    </StackPanel>
                </WrapPanel>

            </StackPanel>

            <Border Padding="10" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <Grid VerticalAlignment="Center" ColumnDefinitions="Auto, Auto">
                        <Label
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Content="Speed:" />
                        <ComboBox
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding SpeedOptions}"
                            SelectedItem="{Binding SelectedSpeed}" />
                    </Grid>
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="Render Chart"
                        IsChecked="{Binding RenderChartDuringSimulation}"
                        ToolTip.Tip="Turn off to skip chart drawing while the simulation runs — results are still recorded for Excel export." />
                    <Button
                        Width="240"
                        Height="40"
                        Classes="primary"
                        Command="{Binding TogglePlayPauseCommand}"
                        Content="{Binding IsPaused, Converter={StaticResource PlayPauseTextConverter}}"
                        FontSize="18" />
                    <Button
                        Width="240"
                        Height="40"
                        Classes="primary"
                        Command="{Binding CancelSimCommand}"
                        Content="❌ Cancel Simulation "
                        IsEnabled="{Binding CanCancelSimulation}"
                        IsVisible="{Binding CanCancelSimulation}" />
                    <Button
                        Width="240"
                        Height="40"
                        Classes="primary"
                        Command="{Binding ClearSimsCommand}"
                        Content="Clear All Simulations"
                        IsEnabled="{Binding CanClearSimulation}"
                        IsVisible="{Binding CanClearSimulation}" />
                    <Button
                        Width="240"
                        Height="40"
                        Classes="primary"
                        Command="{Binding ExportToExcelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="📊 Export to Excel" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,8"
                Padding="10"
                HorizontalAlignment="Center"
                Background="#FFF2F0"
                BorderBrush="#D9534F"
                BorderThickness="1"
                CornerRadius="6"
                IsVisible="{Binding HasSimulationError}">
                <TextBlock
                    Foreground="#D9534F"
                    Text="{Binding SimulationError}"
                    TextWrapping="Wrap" />
            </Border>

        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
            <Border
                Grid.Column="0"
                Margin="0"
                Padding="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="White"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="10">
                <lvc:CartesianChart
                    x:Name="MyChart"
                    Series="{Binding ListOfLines}"
                    XAxes="{Binding XAxes}"
                    ZoomMode="X" />
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0" RowDefinitions="Auto,100">
            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,4"
                Orientation="Horizontal"
                Spacing="8">
                <Button Command="{Binding ResetZoomCommand}" Content="Reset Zoom" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="Gray"
                    FontStyle="Italic"
                    Text="Click a row to jump the chart to that date; double-click for details." />
            </StackPanel>
            <Border
                Grid.Row="1"
                Padding="5"
                Background="White"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="8">
                <DataGrid
                    Name="EpisodesGrid"
                    AutoGenerateColumns="False"
                    CanUserSortColumns="True"
                    DoubleTapped="EpisodesGrid_DoubleTapped"
                    IsReadOnly="True"
                    ItemsSource="{Binding Events}"
                    SelectedItem="{Binding SelectedEvent}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="130" Binding="{Binding ScenarioName}" Header="Scenario" />
                        <DataGridTextColumn Width="100" Binding="{Binding StartDate, StringFormat={}{0:MM/dd/yyyy}}" Header="Sold Off" />
                        <DataGridTextColumn Width="100" Binding="{Binding EndDate, StringFormat={}{0:MM/dd/yyyy}}" Header="Bought Back" />
                        <DataGridTextColumn Width="120" Binding="{Binding EntryReasonCode}" Header="Entry Reason" />
                        <DataGridTextColumn Width="*" Binding="{Binding ExitReasonCode}" Header="Exit Reason" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
